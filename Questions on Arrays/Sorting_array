#include <iostream>
using namespace std;

bool checkArrays(int arr1[], int arr2[], int n, int m)
{
    if (n != m)
        return false;


    // Manually sort arr1
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (arr1[j] > arr1[j + 1]) {
                int temp = arr1[j];
                arr1[j] = arr1[j + 1];
                arr1[j + 1] = temp;
            }
        }
    }

    // Manually sort arr2
    for (int i = 0; i < m - 1; i++) {
        for (int j = 0; j < m - i - 1; j++) {
            if (arr2[j] > arr2[j + 1]) {
                int temp = arr2[j];
                arr2[j] = arr2[j + 1];
                arr2[j + 1] = temp;
            }
        }
    }

    // Compare both arrays
    for (int i = 0; i < n; i++) {
        if (arr1[i] != arr2[i])
            return false;
    }

    return true;
}

int main()
{
    int n, m;

    cout << "Enter size of first array: ";
    cin >> n;

    int arr1[n];

    cout << "Enter elements of first array:\n";
    for (int i = 0; i < n; i++)
        cin >> arr1[i];

    cout << "Enter size of second array: ";
    cin >> m;

    int arr2[m];

    cout << "Enter elements of second array:\n";
    for (int i = 0; i < m; i++)
        cin >> arr2[i];

    if (checkArrays(arr1, arr2, n, m))
        cout << "Equal";
    else
        cout << "Not Equal";

    return 0;
}
